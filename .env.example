# Guide local environment (optional — production uses Supabase Edge Functions)

# Only needed if you run `npm run dev:api` against a local Hono proxy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional. Groq TTS (Orpheus) is billed; free Google TTS is used by default.
# GROQ_API_KEY=

PORT=8787
