# Guide local environment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
PORT=8787

# Bootstrap first admin as username:phone:password
GUIDE_BOOTSTRAP_ADMIN=admin:+10000000000:GuideAdmin1

# Owner phone (E.164). Set in Netlify env / local .env only.
# NEVER commit the real number. Matching accounts become admin.
# Phones are stored server-side only and never returned in API JSON.
GUIDE_OWNER_PHONE=
